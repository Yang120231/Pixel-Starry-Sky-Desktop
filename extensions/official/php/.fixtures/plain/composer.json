{
    "name": "acme/library",
    "type": "library",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.11"
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "analyse": "phpstan analyse src --level=8",
        "cs:fix": "php-cs-fixer fix"
    },
    "scripts-descriptions": {
        "test": "Run the test suite",
        "analyse": "Static analysis: PHPStan"
    },
    "config": {
        "sort-packages": true
    }
}
