[
  {
    "template": "composer-scripts",
    "file": "composer.json",
    "tasks": [
      {
        "name": "setup",
        "linux": "composer run-script setup",
        "windows": "composer run-script setup"
      },
      {
        "name": "dev",
        "linux": "composer run-script dev",
        "windows": "composer run-script dev"
      },
      {
        "name": "test",
        "linux": "composer run-script test",
        "windows": "composer run-script test"
      },
      {
        "name": "post-autoload-dump",
        "linux": "composer run-script post-autoload-dump",
        "windows": "composer run-script post-autoload-dump"
      },
      {
        "name": "post-update-cmd",
        "linux": "composer run-script post-update-cmd",
        "windows": "composer run-script post-update-cmd"
      }
    ]
  },
  {
    "template": "laravel-artisan",
    "file": "composer.json",
    "tasks": [
      {
        "name": "serve",
        "description": "启动本地开发服务器",
        "linux": "php artisan serve",
        "windows": "php artisan serve"
      },
      {
        "name": "test",
        "description": "运行测试（PHPUnit / Pest）",
        "linux": "php artisan test",
        "windows": "php artisan test"
      },
      {
        "name": "migrate",
        "description": "执行数据库迁移",
        "linux": "php artisan migrate",
        "windows": "php artisan migrate"
      },
      {
        "name": "migrate:fresh",
        "description": "删掉所有表并重新迁移",
        "linux": "php artisan migrate:fresh",
        "windows": "php artisan migrate:fresh"
      },
      {
        "name": "migrate:rollback",
        "description": "回滚最近一批迁移",
        "linux": "php artisan migrate:rollback",
        "windows": "php artisan migrate:rollback"
      },
      {
        "name": "db:seed",
        "description": "运行数据填充",
        "linux": "php artisan db:seed",
        "windows": "php artisan db:seed"
      },
      {
        "name": "route:list",
        "description": "列出所有路由",
        "linux": "php artisan route:list",
        "windows": "php artisan route:list"
      },
      {
        "name": "queue:work",
        "description": "启动队列处理进程",
        "linux": "php artisan queue:work",
        "windows": "php artisan queue:work"
      },
      {
        "name": "schedule:work",
        "description": "本地持续运行计划任务",
        "linux": "php artisan schedule:work",
        "windows": "php artisan schedule:work"
      },
      {
        "name": "storage:link",
        "description": "创建 public/storage 软链接",
        "linux": "php artisan storage:link",
        "windows": "php artisan storage:link"
      },
      {
        "name": "optimize:clear",
        "description": "清除配置、路由、视图等缓存",
        "linux": "php artisan optimize:clear",
        "windows": "php artisan optimize:clear"
      }
    ]
  },
  {
    "template": "composer",
    "file": "composer.json",
    "tasks": [
      {
        "name": "install",
        "description": "按锁文件安装依赖",
        "linux": "composer install",
        "windows": "composer install"
      },
      {
        "name": "update",
        "description": "更新依赖并改写锁文件",
        "linux": "composer update",
        "windows": "composer update"
      },
      {
        "name": "dump-autoload",
        "description": "重新生成自动加载文件",
        "linux": "composer dump-autoload",
        "windows": "composer dump-autoload"
      },
      {
        "name": "validate",
        "description": "检查 composer.json 是否有效",
        "linux": "composer validate",
        "windows": "composer validate"
      }
    ]
  }
]
