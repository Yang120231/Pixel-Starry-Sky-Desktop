{
  "单文件组件": {
    "prefix": "sfc",
    "body": [
      "<script setup lang=\"ts\">",
      "$0",
      "</script>",
      "",
      "<template>",
      "\t<div></div>",
      "</template>",
      "",
      "<style scoped>",
      "</style>"
    ],
    "description": "script setup + TypeScript 的单文件组件骨架"
  },
  "script setup": {
    "prefix": "setup",
    "body": ["<script setup lang=\"ts\">", "$0", "</script>"],
    "description": "script setup + TypeScript 块"
  },
  "template 块": {
    "prefix": "tpl",
    "body": ["<template>", "\t$0", "</template>"],
    "description": "template 块"
  },
  "scoped 样式": {
    "prefix": "style",
    "body": ["<style scoped>", "$0", "</style>"],
    "description": "scoped 样式块"
  },
  "scss 样式": {
    "prefix": "styles",
    "body": ["<style scoped lang=\"scss\">", "$0", "</style>"],
    "description": "scoped + scss 样式块"
  },
  "defineProps": {
    "prefix": "props",
    "body": ["const props = defineProps<{", "\t${1:title}: ${2:string}", "}>()"],
    "description": "用类型声明 props"
  },
  "defineProps 带默认值": {
    "prefix": "propsd",
    "body": [
      "const props = withDefaults(defineProps<{",
      "\t${1:size}?: ${2:number}",
      "}>(), {",
      "\t$1: ${3:10},",
      "})"
    ],
    "description": "带默认值的 props（withDefaults）"
  },
  "defineEmits": {
    "prefix": "emits",
    "body": ["const emit = defineEmits<{", "\t${1:change}: [${2:value}: ${3:string}]", "}>()"],
    "description": "用类型声明事件"
  },
  "defineModel": {
    "prefix": "model",
    "body": "const ${1:model} = defineModel<${2:string}>(${3})",
    "description": "defineModel 双向绑定（Vue 3.4+）"
  },
  "defineExpose": {
    "prefix": "expose",
    "body": "defineExpose({ $0 })",
    "description": "向父组件暴露方法或数据"
  },
  "defineOptions": {
    "prefix": "options",
    "body": "defineOptions({ name: '${1:$TM_FILENAME_BASE}' })",
    "description": "defineOptions 设置组件名（Vue 3.3+）"
  },
  "defineSlots": {
    "prefix": "slots",
    "body": ["defineSlots<{", "\tdefault(props: { ${1:item}: ${2:string} }): any", "}>()"],
    "description": "用类型声明插槽"
  },
  "ref": {
    "prefix": "ref",
    "body": "const ${1:name} = ref<${2:string}>(${3:''})",
    "description": "响应式变量 ref"
  },
  "reactive": {
    "prefix": "reactive",
    "body": ["const ${1:state} = reactive({", "\t$0", "})"],
    "description": "响应式对象 reactive"
  },
  "computed": {
    "prefix": "computed",
    "body": "const ${1:name} = computed(() => ${2:value})",
    "description": "计算属性"
  },
  "可写计算属性": {
    "prefix": "computedw",
    "body": ["const ${1:name} = computed({", "\tget: () => ${2:value},", "\tset: (v) => {", "\t\t$0", "\t},", "})"],
    "description": "带 getter / setter 的计算属性"
  },
  "watch": {
    "prefix": "watch",
    "body": ["watch(${1:source}, (${2:value}, ${3:oldValue}) => {", "\t$0", "})"],
    "description": "侦听一个数据源"
  },
  "watch 立即执行": {
    "prefix": "watchi",
    "body": ["watch(${1:source}, (${2:value}) => {", "\t$0", "}, { immediate: true })"],
    "description": "创建时立即执行一次的 watch"
  },
  "watchEffect": {
    "prefix": "watchEffect",
    "body": ["watchEffect(() => {", "\t$0", "})"],
    "description": "自动收集依赖的副作用"
  },
  "onMounted": {
    "prefix": "mounted",
    "body": ["onMounted(() => {", "\t$0", "})"],
    "description": "挂载后执行"
  },
  "onUnmounted": {
    "prefix": "unmounted",
    "body": ["onUnmounted(() => {", "\t$0", "})"],
    "description": "卸载时清理"
  },
  "模板引用": {
    "prefix": "tref",
    "body": "const ${1:el} = useTemplateRef<${2:HTMLElement}>('$1')",
    "description": "模板引用（Vue 3.5+）"
  },
  "provide": {
    "prefix": "provide",
    "body": "provide(${1:key}, ${2:value})",
    "description": "向后代组件提供数据"
  },
  "inject": {
    "prefix": "inject",
    "body": "const ${1:value} = inject<${2:string}>(${3:key}, ${4:defaultValue})",
    "description": "注入祖先组件提供的数据"
  },
  "组合式函数": {
    "prefix": "composable",
    "body": [
      "export function use${1:Thing}() {",
      "\tconst ${2:state} = ref(${3:null})",
      "",
      "\t$0",
      "",
      "\treturn { $2 }",
      "}"
    ],
    "description": "组合式函数（composable）骨架"
  },
  "defineStore（setup 写法）": {
    "prefix": "store",
    "body": [
      "export const use${1:Counter}Store = defineStore('${2:counter}', () => {",
      "\tconst ${3:count} = ref(0)",
      "\tconst double = computed(() => $3.value * 2)",
      "\tfunction increment() {",
      "\t\t$3.value++",
      "\t}",
      "\treturn { $3, double, increment }",
      "})"
    ],
    "description": "Pinia store（setup 写法）"
  },
  "路由表": {
    "prefix": "router",
    "body": [
      "const router = createRouter({",
      "\thistory: createWebHistory(),",
      "\troutes: [",
      "\t\t{ path: '${1:/}', component: () => import('${2:./views/HomeView.vue}') },",
      "\t],",
      "})"
    ],
    "description": "Vue Router 路由表"
  },
  "v-for": {
    "prefix": "vfor",
    "body": ["<li v-for=\"${1:item} in ${2:items}\" :key=\"$1.${3:id}\">", "\t{{ $1 }}", "</li>"],
    "description": "列表渲染（带 key）"
  },
  "v-if / v-else": {
    "prefix": "vif",
    "body": ["<div v-if=\"${1:condition}\">", "\t$0", "</div>", "<div v-else>", "</div>"],
    "description": "条件渲染"
  },
  "v-model": {
    "prefix": "vmodel",
    "body": "<input v-model=\"${1:value}\" type=\"${2:text}\" />",
    "description": "输入框双向绑定"
  },
  "事件绑定": {
    "prefix": "von",
    "body": "<button @click=\"${1:handler}\">${2:按钮}</button>",
    "description": "按钮点击事件"
  },
  "具名插槽": {
    "prefix": "vslot",
    "body": ["<template #${1:header}=\"{ ${2:item} }\">", "\t$0", "</template>"],
    "description": "具名（作用域）插槽"
  },
  "动态组件": {
    "prefix": "component",
    "body": "<component :is=\"${1:current}\" v-bind=\"${2:props}\" />",
    "description": "动态组件"
  },
  "Teleport": {
    "prefix": "teleport",
    "body": ["<Teleport to=\"${1:body}\">", "\t$0", "</Teleport>"],
    "description": "把内容渲染到别处"
  },
  "Suspense": {
    "prefix": "suspense",
    "body": ["<Suspense>", "\t$0", "\t<template #fallback>加载中…</template>", "</Suspense>"],
    "description": "异步依赖加载占位"
  },
  "Vitest 组件测试": {
    "prefix": "vtest",
    "body": [
      "import { mount } from '@vue/test-utils'",
      "import { describe, expect, it } from 'vitest'",
      "import ${1:$TM_FILENAME_BASE} from './$1.vue'",
      "",
      "describe('$1', () => {",
      "\tit('${2:渲染}', () => {",
      "\t\tconst wrapper = mount($1)",
      "\t\texpect(wrapper.text()).toContain('$0')",
      "\t})",
      "})"
    ],
    "description": "Vue Test Utils + Vitest 组件测试"
  }
}
