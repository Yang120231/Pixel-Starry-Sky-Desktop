# 应用的环境变量示例（像素星空 .env 扩展的示例文件）
# ---------- 基本 ----------
APP_NAME="Pixel Demo"
APP_ENV=production
DEBUG=false
PORT=3000
TIMEOUT_SECONDS=12.5

# ---------- 数据库 ----------
DB_HOST=localhost
DB_PORT=5432
DB_USER='admin'
DB_PASSWORD="p@ss\"word"
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/app

# ---------- 第三方 ----------
export API_BASE=https://api.example.com/v1   # 行尾注释
API_KEY=
FEATURE_FLAGS=search,upload,beta
GREETING="你好，$APP_NAME"
MULTI_LINE="第一行\n第二行"
EMPTY_QUOTED=""
RAW_VALUE=$HOME/data
ENABLE_CACHE=true
CACHE_TTL=-1
NULL_VALUE=null

# 下面这行是错误写法：等号前有空格的 key 也能认，但 key 里不能有空格
BAD KEY=value
LAST_LINE=done
