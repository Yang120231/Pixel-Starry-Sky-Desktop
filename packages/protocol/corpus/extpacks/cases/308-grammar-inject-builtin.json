{
  "title": "注入到内置语言：暂时不生效的提示",
  "expectCodes": ["grammar.injectBuiltin"],
  "input": "folder",
  "base": "pixelsky.dotenv",
  "files": {
    "pixelsky-extension.json": {
      "json": {
        "$schema": "../../schema/pixelsky-extension.schema.json",
        "id": "pixelsky.dotenv",
        "name": ".env 文件支持",
        "version": "1.0.0",
        "publisher": "pixelsky",
        "description": ".env 文件的语法高亮、注释切换和常用片段",
        "keywords": ["env", "dotenv", "配置"],
        "license": "MIT",
        "repository": "https://github.com/pixelsky/ext-dotenv",
        "homepage": null,
        "engines": {
          "pixelsky": ">=0.4.0"
        },
        "l10n": {
          "en": {
            "name": ".env Support",
            "description": "Syntax highlighting, comment toggling and snippets for .env files"
          }
        },
        "contributes": {
          "grammars": [
            {
              "language": "dotenv",
              "aliases": ["Dotenv", ".env"],
              "extensions": [".env"],
              "filenames": [".env", ".env.local", ".env.example", ".env.development", ".env.production", ".env.test"],
              "filenamePatterns": [".env.*"],
              "scopeName": "source.dotenv",
              "path": "syntaxes/dotenv.tmLanguage.json",
              "configuration": "language-configuration.json",
              "samples": ["samples/example.env"]
            },
            {
              "injectTo": ["source.js"],
              "scopeName": "source.dotenv-inj",
              "path": "syntaxes/inj.tmLanguage.json",
              "samples": ["samples/example.env"]
            }
          ],
          "snippets": [
            {
              "language": "dotenv",
              "path": "snippets/dotenv.json"
            }
          ]
        },
        "main": null,
        "permissions": [],
        "price": null
      }
    },
    "syntaxes/inj.tmLanguage.json": {
      "json": {
        "scopeName": "source.dotenv-inj",
        "injectionSelector": "L:source.dotenv",
        "patterns": [
          {
            "match": "TODO",
            "name": "keyword.other.todo.dotenv-inj"
          }
        ]
      }
    }
  }
}
