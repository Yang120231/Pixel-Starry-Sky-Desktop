diff --git a/dist/utils/tools-manager.js b/dist/utils/tools-manager.js
index 39b1f1ae3357925c68127b580340208c5d557ed9..77e24475735e8ead0ed997a8e1cebd18f4b12307 100644
--- a/dist/utils/tools-manager.js
+++ b/dist/utils/tools-manager.js
@@ -305,6 +305,11 @@ export async function ensureTool(tool, onStatus) {
     const config = TOOLS[tool];
     if (!config)
         return undefined;
+    // pixelsky: 不自动下载可执行文件；只用 PATH 上的（以后随安装包自带）。PIXELSKY_ALLOW_TOOL_DOWNLOAD=1 可恢复下载
+    if (process.env.PIXELSKY_ALLOW_TOOL_DOWNLOAD !== "1") {
+        onStatus?.({ type: "warning", message: `${config.name} not found on PATH; auto-download is disabled in PixelSky CLI.` });
+        return undefined;
+    }
     if (isOfflineModeEnabled()) {
         onStatus?.({ type: "warning", message: `${config.name} not found. Offline mode enabled, skipping download.` });
         return undefined;
