{
  "name": "pixel-starry-sky",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "dev": "pnpm --filter @pixelsky/desktop dev",
    "dev:demo": "pnpm --filter @pixelsky/desktop dev:demo",
    "build": "pnpm --filter @pixelsky/desktop build",
    "typecheck": "pnpm -r --if-present typecheck",
    "capture": "pnpm --filter @pixelsky/desktop capture",
    "capture:demo": "pnpm --filter @pixelsky/desktop capture:demo",
    "dist": "pnpm --filter @pixelsky/desktop dist",
    "test": "pnpm -r --if-present test",
    "check": "node scripts/check.mjs",
    "ext": "node packages/extension-cli/scripts/run.mjs",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "format": "node node_modules/prettier/bin/prettier.cjs --write .",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "eslint": "9.36.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.44.0"
  }
}
